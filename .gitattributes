# Normaliza para LF no repositório; o checkout usa o padrão da plataforma.
* text=auto

*.html  text eol=lf
*.js    text eol=lf
*.cjs   text eol=lf
*.py    text eol=lf
*.json  text eol=lf
*.md    text eol=lf

